# .env.example — template for local secrets. Copy to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real values. Most of these actually live in
# n8n credentials / the n8n UI — this file just documents the names in one place.

# n8n instance API key (re-paste in the browser / n8n side after bot edits)
N8N_API_KEY=

# Shared secret between the CRM front-end + Apps Script web app + n8n webhooks
# (currently hardcoded as 'ABC' in the .html files — move it here long-term)
CRM_SHARED_SECRET=

# Whapi WhatsApp gateway bearer token
WHAPI_TOKEN=

# OpenAI API key (gpt-4o for the v2 agent)
OPENAI_API_KEY=

# Facebook CAPI System User Access Token
# (ads_management + business_management scopes — for LG-FB Conversion Send)
FB_SYSTEM_USER_TOKEN=

# Google Calendar API — handled via an n8n OAuth credential, no static key here
# GOOGLE_CALENDAR_OAUTH=(configured in n8n, not stored in .env)
