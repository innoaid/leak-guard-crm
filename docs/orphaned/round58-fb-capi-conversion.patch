+// ================================================================
+// Round 58 — capture CTWA referral fields on inbound first message
+// ================================================================
+
+function handleUpdateLeadCtwa(body) {
+  // body: {phone, ctwaClid, fbAdId?, fbAdHeadline?, fbAdSourceUrl?, secret}
+  // Idempotent: only writes a field if (a) the column exists AND
+  // (b) the cell is currently empty (don't clobber existing data on retries).
+  if (!body.phone || !body.ctwaClid) {
+    return jsonResponse({status: 'error', message: 'phone and ctwaClid required'});
+  }
+  const sheet = getSheet();
+  const rowNum = findRowByPhone(sheet, body.phone);
+  if (!rowNum) return jsonResponse({status: 'error', message: 'lead not found', phone: body.phone});
+
+  const h = getHeaders(sheet);
+  const writes = {
+    'CTWA CLID':         body.ctwaClid,
+    'FB Ad ID':          body.fbAdId,
+    'FB Ad Headline':    body.fbAdHeadline,
+    'FB Ad Source URL':  body.fbAdSourceUrl,
+  };
+  const written = [];
+  Object.keys(writes).forEach(function(header) {
+    const v = writes[header];
+    const col = h.colByName[header];
+    if (!col || !v) return;
+    const cur = String(sheet.getRange(rowNum, col).getValue() || '').trim();
+    if (cur) return; // first-write-wins — referral is locked at first ad click
+    sheet.getRange(rowNum, col).setValue(v);
+    written.push(header);
+  });
+
+  return jsonResponse({status: 'ok', rowNum: rowNum, written: written});
+}
+
+// ================================================================
+// Round 58 — bootstrap CTWA columns (run ONCE manually from editor)
+// ================================================================
+
+function bootstrapCtwaColumns() {
+  // Idempotent — appends only the columns that aren't already in the header row.
+  const sheet = getSheet();
+  const lastCol = sheet.getLastColumn();
+  const headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0]
+    .map(function(h) { return String(h || '').trim(); });
+
+  const wanted = ['FB Ad ID', 'FB Ad Headline', 'FB Ad Source URL', 'CTWA CLID'];
+  const missing = wanted.filter(function(name) { return headers.indexOf(name) === -1; });
+
+  if (missing.length === 0) {
+    Logger.log('bootstrapCtwaColumns: all 4 columns already present, nothing to do.');
+    return;
+  }
+
+  const startCol = lastCol + 1;
+  sheet.getRange(1, startCol, 1, missing.length).setValues([missing]);
+  Logger.log('bootstrapCtwaColumns: appended ' + missing.length + ' column(s) starting at col ' + startCol + ': ' + missing.join(', '));
+}
